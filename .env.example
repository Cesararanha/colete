# Public, non-secret build switch used only by the local M0-A smoke harness.
EXPO_PUBLIC_SMOKE_MODE=false

# Public client configuration. Never put a secret/service-role key in an EXPO_PUBLIC variable.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example_only
