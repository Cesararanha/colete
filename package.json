{
  "name": "colete",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.13.0 <25",
    "npm": ">=11.12.1 <12"
  },
  "volta": {
    "node": "24.20.0",
    "npm": "11.19.0"
  },
  "scripts": {
    "start": "cross-env EXPO_NO_TELEMETRY=1 expo start",
    "android": "cross-env EXPO_NO_TELEMETRY=1 expo start --android",
    "ios": "cross-env EXPO_NO_TELEMETRY=1 expo start --ios",
    "web": "cross-env EXPO_NO_TELEMETRY=1 expo start --web",
    "build:web": "cross-env EXPO_NO_TELEMETRY=1 expo export --platform web --clear",
    "build:web:smoke": "cross-env EXPO_NO_TELEMETRY=1 EXPO_PUBLIC_SMOKE_MODE=true expo export --platform web --clear",
    "build:web:auth-e2e": "node scripts/build-auth-e2e.mjs",
    "serve:web": "serve dist --listen 4173 --no-clipboard",
    "lint": "cross-env EXPO_NO_TELEMETRY=1 expo lint",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke:web": "playwright test e2e/m0-a-smoke.spec.ts",
    "test:auth:web": "playwright test e2e/m1-a-auth.spec.ts",
    "test:privacy:web": "playwright test e2e/m1-b-privacy.spec.ts",
    "scan:docs": "node scripts/verify-docs.mjs",
    "scan:secrets": "secretlint \"**/*\" && node scripts/verify-secret-boundaries.mjs",
    "audit:high": "npm audit --audit-level=high",
    "verify:pwa": "node scripts/verify-pwa.mjs",
    "verify:auth-config": "node scripts/verify-auth-config.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "generate:error-codes": "node scripts/generate-error-codes.mjs",
    "generate:db-types": "node scripts/generate-db-types.mjs",
    "db:start": "node scripts/start-local-supabase.mjs",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db --local",
    "db:test:idempotency": "node scripts/test-idempotency-concurrency.mjs",
    "db:test:gateway": "node scripts/test-identity-gateway.mjs",
    "db:test:worker": "node scripts/test-worker-foundation.mjs",
    "db:test:deletion": "node scripts/test-account-deletion.mjs",
    "db:test:export": "node scripts/test-data-export-delivery.mjs",
    "db:test:groups": "node scripts/test-group-foundation.mjs",
    "db:test:membership": "node scripts/test-group-membership.mjs",
    "db:stop": "supabase stop --no-backup",
    "verify:app": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build:web && npm run verify:pwa && npm run verify:auth-config && npm run scan:docs && npm run scan:secrets"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.14",
    "@hookform/resolvers": "5.9.1",
    "@supabase/supabase-js": "2.115.0",
    "@tanstack/react-query": "5.102.8",
    "expo": "57.0.18",
    "expo-constants": "57.0.16",
    "expo-document-picker": "57.0.1",
    "expo-linking": "57.0.8",
    "expo-router": "57.0.17",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.87.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.5",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "pg": "8.23.0",
    "prettier": "3.9.6",
    "secretlint": "13.0.5",
    "serve": "14.2.6",
    "sharp": "0.35.4",
    "supabase": "2.118.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
